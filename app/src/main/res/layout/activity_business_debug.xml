<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:id="@+id/business_root" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/debug_heading" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/debug_identity" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/debug_instructions" android:layout_marginTop="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/debug_operation_label" android:layout_marginTop="16dp" />
        <Spinner android:id="@+id/debug_operation" android:layout_width="match_parent"
            android:layout_height="48dp" android:contentDescription="@string/debug_operation_label" />
        <LinearLayout android:id="@+id/debug_filters" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
            <Spinner android:id="@+id/debug_type" android:layout_width="match_parent"
                android:layout_height="48dp" android:contentDescription="@string/debug_type_label" />
            <Spinner android:id="@+id/debug_category" android:layout_width="match_parent"
                android:layout_height="48dp" android:contentDescription="@string/debug_category_label" />
            <EditText android:id="@+id/debug_keyword" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/debug_keyword_hint" android:inputType="text" android:importantForAutofill="no" />
        </LinearLayout>
        <LinearLayout android:id="@+id/debug_publish_fields" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
            <EditText android:id="@+id/debug_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/debug_title_hint" android:inputType="text" android:importantForAutofill="no" android:text="@string/debug_sample_title"/>
            <EditText android:id="@+id/debug_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/debug_description_hint" android:inputType="text" android:importantForAutofill="no" android:text="@string/debug_sample_description"/>
            <EditText android:id="@+id/debug_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/debug_location_hint" android:inputType="text" android:importantForAutofill="no" android:text="@string/debug_sample_location"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/debug_id_group" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/debug_id_label" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText android:id="@+id/debug_id" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:hint="@string/debug_id_hint" android:inputType="number" android:importantForAutofill="no" />
        </LinearLayout>
        <LinearLayout android:id="@+id/debug_claim_fields" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
            <EditText android:id="@+id/debug_proof" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/debug_proof_hint" android:inputType="text" android:importantForAutofill="no" android:text="@string/debug_sample_proof"/>
            <EditText android:id="@+id/debug_contact" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/debug_contact_hint" android:inputType="text" android:importantForAutofill="no" android:text="@string/debug_sample_contact"/>
        </LinearLayout>
        <EditText android:id="@+id/debug_reason" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/debug_reason_hint" android:inputType="text" android:importantForAutofill="no" android:text="@string/debug_sample_reason"/>
        <LinearLayout android:id="@+id/debug_status_group" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/debug_status_label" />
            <Spinner android:id="@+id/debug_status" android:layout_width="match_parent"
                android:layout_height="48dp" android:contentDescription="@string/debug_status_label" />
        </LinearLayout>
        <Button android:id="@+id/debug_send" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/debug_send" android:enabled="false" />
        <TextView android:id="@+id/debug_output" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:textIsSelectable="true" android:accessibilityLiveRegion="polite" android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
