<?xml version="1.0" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:id="@+id/main" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <Space android:layout_width="1dp" android:layout_height="48dp"/>
        <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_box" android:importantForAccessibility="no"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_title" android:textAppearance="@style/UiTitle" android:layout_marginTop="24dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_step_two" android:textAppearance="@style/UiSection" android:layout_marginTop="20dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_intro" android:textAppearance="@style/UiBody" android:layout_marginTop="16dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/open_client" style="@style/UiButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_open_client" android:layout_marginTop="40dp" app:icon="@drawable/ic_search"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/open_host" style="@style/UiOutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_open_host" android:layout_marginTop="12dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_role_hint" android:textAppearance="@style/UiCaption" android:layout_marginTop="24dp"/>
    </LinearLayout>
</ScrollView>
