<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/business_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" app:title="@string/ui_received" app:navigationIcon="@drawable/ic_back" app:navigationContentDescription="@string/ui_back"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:orientation="vertical">
        <ProgressBar android:id="@+id/page_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="gone"/>
        <TextView android:id="@+id/page_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="8dp" android:textAppearance="@style/UiCaption" android:accessibilityLiveRegion="polite" android:saveEnabled="false"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/page_retry" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ui_retry" android:visibility="gone"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/business_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/received_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/UiSection" android:paddingHorizontal="20dp" android:layout_marginBottom="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp">
            <Spinner android:id="@+id/received_status" style="@style/UiSpinner" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:contentDescription="@string/ui_status_filter" android:prompt="@string/ui_status_filter"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/refresh_claims" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ui_refresh"/>
        </LinearLayout>
        <ListView android:id="@+id/received_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingHorizontal="20dp" android:clipToPadding="false" android:divider="@color/ui_surface_container" android:dividerHeight="1dp"/>
    </LinearLayout>
</LinearLayout>
