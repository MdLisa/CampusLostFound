<?xml version="1.0" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:id="@+id/host_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/admin_host_title" android:textAppearance="@style/UiTitle" android:textStyle="bold"/>
        <TextView android:id="@+id/host_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:accessibilityLiveRegion="polite" android:text="@string/host_stopped" android:textSize="18sp"/>
        <com.google.android.material.button.MaterialButton style="@style/UiButton" android:id="@+id/start_server" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/host_start"/>
        <com.google.android.material.button.MaterialButton style="@style/UiButton" android:id="@+id/stop_server" android:layout_width="match_parent" android:layout_height="wrap_content" android:enabled="false" android:text="@string/host_stop"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/host_address_label" android:textStyle="bold"/>
        <TextView android:id="@+id/host_addresses" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textIsSelectable="true" android:textSize="16sp"/>
        <com.google.android.material.button.MaterialButton style="@style/UiButton" android:id="@+id/refresh_addresses" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/host_refresh"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/host_test_hint" android:textSize="16sp"/>
        <include layout="@layout/host_admin_panel"/>
    </LinearLayout>
</ScrollView>
