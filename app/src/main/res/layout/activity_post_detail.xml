<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/business_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" app:title="@string/ui_post_detail" app:navigationIcon="@drawable/ic_back" app:navigationContentDescription="@string/ui_back"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:orientation="vertical">
        <ProgressBar android:id="@+id/page_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="gone"/>
        <TextView android:id="@+id/page_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="8dp" android:textAppearance="@style/UiCaption" android:accessibilityLiveRegion="polite" android:saveEnabled="false"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/page_retry" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ui_retry" android:visibility="gone"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/business_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingBottom="24dp">
                <TextView android:id="@+id/detail_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/UiCaption"/>
                <TextView android:id="@+id/detail_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/UiCaption" android:layout_marginTop="4dp"/>
                <TextView android:id="@+id/detail_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/UiTitle" android:layout_marginTop="12dp"/>
                <TextView android:id="@+id/detail_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/UiBody" android:layout_marginTop="12dp"/>
                <TextView android:id="@+id/detail_owner" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/UiCaption" android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/detail_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/UiCaption" android:layout_marginTop="4dp"/>
                <ImageView android:id="@+id/detail_photo" android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="24dp" android:scaleType="fitCenter" android:contentDescription="@string/photo_remote_description" android:visibility="gone" android:background="@drawable/bg_field"/>
                <TextView android:id="@+id/detail_photo_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/UiCaption" android:layout_marginTop="16dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/retry_photo" style="@style/UiOutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_image_retry" android:visibility="gone"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_detail_description" android:textAppearance="@style/UiSection" android:layout_marginTop="24dp"/>
                <TextView android:id="@+id/detail_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/UiBody" android:layout_marginTop="12dp" android:textIsSelectable="true"/>
                <LinearLayout android:id="@+id/post_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical" android:visibility="gone">
                    <com.google.android.material.button.MaterialButton android:id="@+id/apply_claim" style="@style/UiButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_apply"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/received_claims" style="@style/UiButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_received"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/resolve_post" style="@style/UiOutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_resolve" android:layout_marginTop="12dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/close_post" style="@style/UiOutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_close" android:layout_marginTop="12dp" android:textColor="@color/ui_error"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_no_actions" android:textAppearance="@style/UiCaption" android:id="@+id/detail_ended" android:layout_marginTop="12dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
