<?xml version="1.0" ?>
<resources>
    <style name="UiTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/ui_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="UiSection" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/ui_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="UiBody" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/ui_on_surface</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="UiCaption" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/ui_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="UiInput" parent="Widget.AppCompat.EditText">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ui_on_surface</item>
        <item name="android:textColorHint">@color/ui_secondary</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/bg_field</item>
    </style>
    <style name="UiSpinner" parent="Widget.AppCompat.Spinner">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>
    <style name="UiButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">16dp</item>
    </style>
    <style name="UiOutlineButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">16dp</item>
    </style>
</resources>
